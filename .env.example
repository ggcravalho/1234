# Chave da API da Anthropic (Claude), usada para interpretar planos colados
# em texto livre e para o assistente de IA que gera novos planos.
ANTHROPIC_API_KEY=

# Opcional: sobrescreve o modelo usado nas chamadas de IA.
# ANTHROPIC_MODEL=claude-sonnet-5

# Caminho do arquivo SQLite (opcional; padrão: .data/bitusfit.db)
# BITUSFIT_DB_PATH=.data/bitusfit.db

# Usados apenas por `pnpm seed`, para criar as duas contas do casal.
SEED_USER1_NAME=
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER2_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
