# Chave gratuita da API do Gemini (Google AI Studio), usada para interpretar
# planos colados em texto livre e para o assistente de IA que gera novos
# planos. Crie a sua em https://aistudio.google.com/apikey (tier gratuito,
# sem cartão de crédito, com limite de requisições por dia/minuto).
GEMINI_API_KEY=

# Opcional: sobrescreve o modelo usado nas chamadas de IA.
# GEMINI_MODEL=gemini-3.6-flash

# Caminho do arquivo SQLite (opcional; padrão: .data/bitusfit.db)
# BITUSFIT_DB_PATH=.data/bitusfit.db

# Usados apenas por `pnpm seed`, para criar as duas contas do casal.
SEED_USER1_NAME=
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER2_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
